material ScrollingClouds
{
    // first, preferred technique
    technique
    {
        // first pass
        pass
        {
            ambient 0.5 0.5 0.5
            diffuse 1.0 0.5 0.5
            
            // Texture unit 0
            texture_unit 
            {
                texture clouds.jpg
                scroll_anim 0.2 0.1
            }
 
            // Additional RT Shader system options
            rtshader_system
            {
                // Do lighting calculations per-pixel 
                lighting_stage per_pixel
            }
        }
    }
 
    // Second technique, can be used as a fallback or LOD level
    technique
    {
        // .. and so on
    }   
}
