// Simple Colors

material Basics/Red
{
    technique
    {
        pass
        {
            texture_unit 
            {
                colour_op_ex source1 src_manual src_current 1 0 0
            }
        }
    }

    rtshader_system
    {
        lighting_stage per_pixel
    }
}

